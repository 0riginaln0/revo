#!
global table helpers, calllable as `{1, 2}:at(0)` and `table.at({1, 2}, 0)`
!#

#*
gets value without metamethods
returns :undef if key missing
*#
pub declare table.rawget = fn(self: table, key: any) -> any | :undef

#*
gets array element at 0-based index, metatable-ignoring
returns :undef when out of range
*#
pub declare table.at<T> = fn(self: table<T>, index: num) -> T | :undef

#*
whether a 0-based index holds an array element, metatable-ignoring
*#
pub declare table.at? = fn(self: table, index: num) -> bool

#*
gets map value, metatable-ignoring
returns :undef if key missing
*#
pub declare table.key<V> = fn(self: table<V>, key: any) -> V | :undef

#* the array part's last element *#
pub declare table.last = fn(self: table) -> table

#*
whether a key exists, metatable-ignoring
*#
pub declare table.key? = fn(self: table, key: any) -> bool

#* sets value without metamethods *#
pub declare table.rawset = fn(self: table, key: any, value: any) -> table

#* sets the metatable of the table, `:undef` clears it *#
pub declare table.set_meta = fn(self: table, meta: :undef|table) -> table

#* returns metatable of value or :undef *#
pub declare table.get_meta = fn(self: table) -> table | :undef

#* unwraps result, panics if not :ok *#
pub declare table.unwrap<T> = fn(self: {:ok, T} | table) -> T

#* extracts error from result, panics if not :err *#
pub declare table.unwrap_err<T> = fn(self: {:err, T} | table) -> T

#* inserts value at position, shifting elements right *#
pub declare table.insert<T> = fn(self: table<T>, pos: num, value: T) -> :ok

#* inserts elements as last *#
pub declare table.push = fn(self: table, values: any...) -> table

#* removes and returns the last array element, or :undef if empty *#
pub declare table.pop<T> = fn(self: table<T>) -> T | :undef

#* removes element at position or key, returns removed value *#
pub declare table.remove<T> = fn(self: table<T>, key: any) -> T

#* joins array elements with delimiter *#
pub declare table.join = fn(self: table, delim: string) -> string

#* returns all keys as table (array indices + hash keys) *#
pub declare table.keys<K, V> = fn(self: table<K, V>) -> table<K>

#* returns all values as table *#
pub declare table.values<K, V> = fn(self: table<K, V>) -> table<V>

#* creates shallow copy of table *#
pub declare table.copy<T> = fn(self: table<T>) -> table<T>

#*
merges second table into first
later values overwrite earlier ones
*#
pub declare table.merge<K, V> = fn(self: table<K, V>, other: table<K, V>) -> table<K, V>

#* sorts table array part in ascending order (numbers < strings) *#
pub declare table.sort<T> = fn(self: table<T>) -> table<T>

#* sorts table array part using comparison function fn(a, b) -> bool (true if a < b) *#
pub declare table.sort_by = fn(self: table, fn: function) -> table

#* reverses table array part in place *#
pub declare table.reverse<T> = fn(self: table<T>) -> table<T>

#* flattens nested tables into single array (non-table elements pass through) *#
pub declare table.flatten = fn(self: table<any>) -> table<any>

#* returns 0-based index of value in the array part, or nil if not found *#
pub declare table.index_of = fn(self: {}, value: any) -> num|:nil

#* returns the number of times a specified value appears in a table's array part *#
pub declare table.count_of = fn(self: {}, search_val: any) -> num

#* checks if table contains value *#
pub declare table.contains? = fn(self: table, value: any) -> bool

#* removes duplicate elements *#
pub declare table.unique<T> = fn(self: table<T>) -> table<T>

#* returns total length of table (array part + keyed entries) *#
pub declare table.len = fn(self: table) -> num

#* returns length of table array part only *#
pub declare table.alen = fn(self: table) -> num

#* returns length of table keyed entries only *#
pub declare table.klen = fn(self: table) -> num

#* reports whether the table holds no entries at all *#
pub declare table.empty? = fn(self: table) -> bool

#* creates a deep copy of the table, duplicating nested tables (cycles map to their in-progress copy) *#
pub declare table.deep_copy<T> = fn(self: table<T>) -> table<T>

#* applies fn to the value at key (missing reads as :nil) and stores the result back, returns self *#
pub declare table.update<T> = fn(self: table<T>, key: any, fn: function) -> table<T>

#* returns a new table with array items [start, end), end defaults to the array length, bounds clamp *#
pub declare table.slice<T> = fn(self: table<T>, start: num, end: num...) -> table<T>

#* repeats table array part n times *#
pub declare table.repeat<T> = fn(self: table<T>, n: num) -> table<T>
