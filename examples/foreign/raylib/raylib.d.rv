#!
the raylib_revo.so manifest

import 'raylib_revo.so' should pick this right up

colors should be tables or rgba but really arent yet
!#

#* open a window *#
pub declare init_window = fn(width: number, height: number, title: string) -> :nil

#* close the window *#
pub declare close_window = fn() -> :nil

#* check if close button or esc was pressed *#
pub declare window_should_close = fn() -> bool

#* set target frames per second *#
pub declare set_target_fps = fn(fps: number) -> :nil

#* get current fps *#
pub declare get_fps = fn() -> number

#* get time in seconds for last frame *#
pub declare get_frame_time = fn() -> number

#* get screen width in pixels *#
pub declare get_screen_width = fn() -> number

#* get screen height in pixels *#
pub declare get_screen_height = fn() -> number

#* begin drawing mode *#
pub declare begin_drawing = fn() -> :nil

#* end drawing mode *#
pub declare end_drawing = fn() -> :nil

#* clear background with color (r, g, b) *#
pub declare clear_background = fn(r: number, g: number, b: number) -> :nil

#* draw text at position *#
pub declare draw_text = fn(text: string, x: number, y: number, size: number, r: number, g: number, b: number) -> :nil

#*
draw filled rectangle
this is where we'll get to try type declarations
*#
pub declare draw_rectangle = fn(x: number, y: number, w: number, h: number, r: number, g: number, b: number) -> :nil

#* draw filled circle *#
pub declare draw_circle = fn(cx: number, cy: number, radius: number, r: number, g: number, b: number) -> :nil

#* draw line with thickness *#
pub declare draw_line = fn(x1: number, y1: number, x2: number, y2: number, thick: number, r: number, g: number, b: number) -> :nil

#* draw fps counter *#
pub declare draw_fps = fn(x: number, y: number) -> :nil

#* check if key was just pressed *#
pub declare is_key_pressed = fn(key: number) -> bool

#* check if key is held down *#
pub declare is_key_down = fn(key: number) -> bool

#* check if key was just released *#
pub declare is_key_released = fn(key: number) -> bool

#* get key that was just pressed (0 if none) *#
pub declare get_key_pressed = fn() -> number

#* check if mouse button was just pressed *#
pub declare is_mouse_button_pressed = fn(button: number) -> bool

#* check if mouse button is held down *#
pub declare is_mouse_button_down = fn(button: number) -> bool

#* get mouse x position *#
pub declare get_mouse_x = fn() -> number

#* get mouse y position *#
pub declare get_mouse_y = fn() -> number

#* measure text width in pixels *#
pub declare measure_text = fn(text: string, size: number) -> number
