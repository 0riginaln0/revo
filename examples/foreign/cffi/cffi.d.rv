#!
if you ever get an error that ends with "???", its a library bug
!#

#* load("libraylib.so") -> lib table with t:func() method *#
pub declare load = fn(lib: string) -> table

#* dlclose a handle *#
pub declare free = fn(lib: table)

#*
```revo
let iw = lib:func("InitWindow", {"i", "i", "s"}, "v") # -> callable table

iw(a, b, c)    # spread args (no table alloc!)
iw{args_table} # table args
iw()           # no args
```
*#
pub declare func = fn(lib: table, name: string, sig: table, ret: string) -> table
