#!
ideally the api would be
# this via cffi.load returning a table with `set_meta(cffi.load("./libraylib.so"), {func = cffi.func})` done
let rl = cffi.load("./libraylib.so")
# this via wrapping it in a metatable with __call set
let initwin = rl:func("InitWindow", {"i", "i", "s"}, "v")
initwin{640, 480, "yay"}
!#

#* load("libraylib.so") *#
pub declare load = fn(lib: string) -> any

#* free(thing)*#
pub declare free = fn(lib: any)

#* func(thing, "InitWindow" *#
pub declare func = fn(lib: any, func: string) -> any

#* call(func, {640, 480, "hi!"}, {"i", "i", "s"}, "v") *#
pub declare call = fn(func: any, args: table, sig: table, ret: string) -> any
